set -eu

# Load non-secret project settings without executing the file as shell code.
dotenv_if_exists .env

secret_file="${OPENHANAKO_RELEASE_DIGEST_SECRET_FILE:-$HOME/.secrets/openhanako-release-digest}"
if [ -f "$secret_file" ]; then
  case "$(uname -s)" in
    Darwin) secret_mode="$(stat -f %Lp "$secret_file")" ;;
    Linux) secret_mode="$(stat -c %a "$secret_file")" ;;
    *) secret_mode="" ;;
  esac
  case "$secret_mode" in
    *[1-7][0-7]|*[0-7][1-7])
      echo "Release-digest secret file must not be group/world accessible (use chmod 600): $secret_file" >&2
      return 1
      ;;
  esac

  # Parse the explicit env-formatted secret file; do not source or print it.
  dotenv "$secret_file"
else
  echo "Release-digest secret file not loaded (optional for normal development): $secret_file" >&2
fi
