set -eu

# Load non-secret project settings without executing the file as shell code.
dotenv_if_exists .env

secret_file_was_configured=false
if [ "${OPENHANAKO_RELEASE_DIGEST_SECRET_FILE+x}" = x ]; then
  secret_file_was_configured=true
  secret_file="$OPENHANAKO_RELEASE_DIGEST_SECRET_FILE"
  if [ -z "$secret_file" ]; then
    echo "OPENHANAKO_RELEASE_DIGEST_SECRET_FILE must not be empty" >&2
    return 1
  fi
else
  secret_file="$HOME/.secrets/openhanako-release-digest"
fi

if [ -f "$secret_file" ]; then
  case "$(uname -s)" in
    Darwin) secret_mode="$(stat -f %Lp "$secret_file")" ;;
    Linux) secret_mode="$(stat -c %a "$secret_file")" ;;
    *) secret_mode="" ;;
  esac
  case "$secret_mode" in
    *[1-7][0-7]|*[0-7][1-7])
      echo "Release-digest secret file must not be group/world accessible (use chmod 600): $secret_file" >&2
      return 1
      ;;
  esac

  # direnv's stdlib dotenv wrapper can hide parser failures behind eval.
  # Pre-validate silently so malformed input cannot echo credential material.
  if ! direnv dotenv bash "$secret_file" >/dev/null 2>&1; then
    echo "Release-digest secret file is not valid dotenv data: $secret_file" >&2
    return 1
  fi

  # Parse the env-formatted secret file; do not source or print it.
  dotenv "$secret_file"
elif [ "$secret_file_was_configured" = true ]; then
  echo "Configured release-digest secret file not found: $secret_file" >&2
  return 1
else
  echo "Release-digest secret file not loaded (optional for normal development): $secret_file" >&2
fi
